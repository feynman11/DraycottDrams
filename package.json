{
  "name": "draycott-drams-whisky-club",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx db/seed.ts",
    "db:import:wikidata": "tsx scripts/import-wikidata-distilleries.ts",
    "db:seed:distilleries": "tsx db/seed-distilleries.ts",
    "data:fetch:distilleries:wikidata": "tsx scripts/fetch-wikidata-distilleries.ts",
    "db:migrate-from-postgres": "tsx scripts/migrate-from-postgres.ts",
    "db:check": "drizzle-kit generate && test -z \"$(git status --porcelain -- db/migrations)\" || (echo \"db/schema.ts and db/migrations differ: run pnpm db:generate and commit the migration\" && exit 1)",
    "preview": "vite preview",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local -c wrangler.jsonc",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging -c wrangler.jsonc",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote -c wrangler.jsonc",
    "deploy:staging": "CLOUDFLARE_ENV=staging vite build && wrangler deploy",
    "deploy:production": "vite build && wrangler deploy",
    "dev:ai": "DD_REMOTE_BINDINGS=1 vite dev"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@hono/trpc-server": "^0.4.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.13",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@tanstack/react-router": "^1.170.45",
    "@trpc/client": "^11.8.1",
    "@trpc/react-query": "^11.8.1",
    "@trpc/server": "^11.8.1",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.13",
    "lucide-react": "^0.561.0",
    "maplibre-gl": "^5.15.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.4.0",
    "topojson-client": "^3.1.0",
    "xlsx": "^0.18.5",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@types/maplibre-gl": "^1.14.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wrangler": "^4.151.3"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=26.10.0 <27"
  }
}
